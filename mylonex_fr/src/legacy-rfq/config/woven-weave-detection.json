  "extractionPolicy": {
    "goal": "Recognize listed weave names and surface plausible names missing from this vocabulary.",
    "knownTerm": {
      "outputStatus": "recognized",
      "outputFields": [
        "canonicalFamily",
        "matchedTerm",
        "originalText",
        "confidence"
      ],
      "confidence": "High for exact alias match when context agrees."
    },
    "unknownTermWithCue": {
      "cues": [
        "weave",
        "woven",
        "weave type",
        "weave pattern",
        "fabric construction",
        "construction",
        "structure"
      ],
      "behavior": "Extract the nearest meaningful word or phrase as an unknown weave candidate; never discard it.",
      "outputStatus": "candidate_needs_review",
      "outputFields": [
        "candidateText",
        "originalText",
        "cue",
        "confidence",
        "needsReview"
      ],
      "confidence": "Medium with a clear cue; low when ambiguous."
    },
    "unknownStandaloneTerm": {
      "behavior": "In specification context, surface unknown standalone terms as low-confidence candidates for human review; do not assume every fabric or pattern word is a weave.",
      "outputStatus": "possible_candidate_needs_review",
      "needsReview": true
    },
    "multipleMatches": "Return every distinct weave mention.",
    "preservation": "Keep buyer original text unchanged and store detection separately.",
    "noMatch": "Return no detected weave and leave the field blank; do not guess."
  },
  "avoidFalsePositives": {
    "separateFromWeave": [
      "fiber/composition",
      "yarn count or yarn construction",
      "color/shade",
      "finish/treatment",
      "fabric state/process",
      "garment/end use"
    ],
    "contextRules": [
      "A pattern may be printed or embroidered rather than woven; retain separately unless text says woven.",
      "Dobby and jacquard can describe loom-controlled patterning; do not infer a specific structure from these terms alone.",
      "Denim, poplin, Oxford, gabardine, or corduroy may suggest a construction but do not prove one exact weave.",
      "If a term is both fabric name and alias and context is unclear, set needsReview=true.",
      "Do not treat knitted, knit, warp-knit, weft-knit, or nonwoven as woven weave matches."
    ],
    "excludedNonWovenCues": [
      "knit",
      "knitted",
      "warp knit",
      "weft knit",
      "nonwoven",
      "non-woven"
    ]
  },
  "implementationNotes": [
    "This JSON is a vocabulary, not the full detection algorithm.",
    "Match aliases deterministically first; then extract candidates around weave/construction cues for missing terms.",
    "Never silently map an unknown term to a known family with fuzzy matching or AI.",
    "After human review, add verified new terms to the vocabulary."
  ]
}
